    "public.v_item_stock": {
      "columns": {
        "id": {
          "name": "id",
          "type": "bigserial",
          "primaryKey": true,
          "notNull": true
        }
      },
      "definition": "select \"items\".\"id\", coalesce(sum(\"inventory_ledger\".\"on_hand_delta\"), 0) as \"on_hand_qty\", coalesce(sum(\"inventory_ledger\".\"allocated_delta\"), 0) as \"allocated_qty\", coalesce(sum(\"inventory_ledger\".\"on_hand_delta\"), 0) - coalesce(sum(\"inventory_ledger\".\"allocated_delta\"), 0) as \"available_qty\" from \"items\" left join \"inventory_ledger\" on \"inventory_ledger\".\"item_id\" = \"items\".\"id\" group by \"items\".\"id\"",
      "name": "v_item_stock",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
